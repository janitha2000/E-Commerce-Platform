PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/stylora
APP_BASE_URL=http://localhost:5000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google OAuth (optional). Register this exact callback URL in Google Cloud:
# http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayHere sandbox is used unless PAYHERE_MODE=live.
# Register APP_BASE_URL with PayHere and use its domain-specific merchant secret.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
